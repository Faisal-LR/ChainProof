generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum IPCategory {
  LOGO
  ARTWORK
  SOFTWARE
  ALGORITHM
  PHOTOGRAPHY
  RESEARCH
  DOCUMENT
  MUSIC
  DESIGN
  WRITING
  OTHER
}

enum BlockchainStatus {
  PENDING
  CONFIRMED
  FAILED
  UNAVAILABLE
}

enum VerificationType {
  EXACT
  LOGO_VISUAL
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  passwordHash  String
  role          Role             @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  registrations IPRegistration[]
  verifications VerificationRecord[]
  auditLogs     AuditLog[]
}

model IPRegistration {
  id                  String             @id @default(cuid())
  ipId                String             @unique
  rootIpId            String
  title               String
  description         String?
  category            IPCategory
  creatorName         String
  creatorId           String
  creator             User               @relation(fields: [creatorId], references: [id])
  sha256              String             @unique
  storageKey          String
  storageUrl          String?
  mimeType            String
  fileSize            Int
  license             String
  tags                String[]           @default([])
  version             Int                @default(1)
  previousIpId        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  blockchainTxHash    String?
  blockchainStatus    BlockchainStatus   @default(UNAVAILABLE)
  contractAddress     String?
  blockchainError     String?
  logoFingerprint     LogoFingerprint?
  versions            IPVersion[]
  transactions        BlockchainTransaction[]
  verificationMatches VerificationRecord[] @relation("MatchedRegistration")
  @@index([rootIpId])
  @@index([category])
  @@index([creatorId])
  @@index([createdAt])
}

model IPVersion {
  id               String         @id @default(cuid())
  registrationId   String
  registration     IPRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  rootIpId         String
  ipId             String         @unique
  version          Int
  previousIpId     String?
  sha256           String
  createdAt        DateTime       @default(now())
  @@unique([rootIpId, version])
  @@index([rootIpId])
}

model LogoFingerprint {
  id               String         @id @default(cuid())
  ipRegistrationId String         @unique
  registration     IPRegistration @relation(fields: [ipRegistrationId], references: [id], onDelete: Cascade)
  fingerprint      String
  createdAt        DateTime       @default(now())
}

model BlockchainTransaction {
  id               String           @id @default(cuid())
  ipRegistrationId String
  registration     IPRegistration   @relation(fields: [ipRegistrationId], references: [id], onDelete: Cascade)
  txHash           String?
  network          String?
  contractAddress  String?
  status           BlockchainStatus
  error            String?
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?
  @@index([ipRegistrationId])
}

model VerificationRecord {
  id                    String           @id @default(cuid())
  type                  VerificationType
  sha256                String?
  searchedById          String?
  searchedBy            User?            @relation(fields: [searchedById], references: [id])
  matchedRegistrationId String?
  matchedRegistration   IPRegistration?  @relation("MatchedRegistration", fields: [matchedRegistrationId], references: [id])
  result                String
  createdAt             DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

model RegistryCounter {
  id    Int @id
  value Int @default(0)
}
